# 後端真實 API Base URL（亦支援無 VITE_ 前綴的 API_BASE_URL）
VITE_API_BASE_URL=http://localhost:8000/api/v1

# 是否啟用假資料 Mock 模式（支援 true, false, 0, 1, no, yes 等格式）
VITE_USE_MOCK=true

# API 請求逾時時間（毫秒）
VITE_API_TIMEOUT_MS=15000

# Google Identity Services 網頁用戶端 ID（公開值，不是 client secret）
# 留空時，真實 API 模式會關閉業務畫面。不要把 client secret 放進前端。
VITE_GOOGLE_CLIENT_ID=
